{
  "version": "local-default",
  "mode": "monitor",
  "kill_switch": false,
  "read_form_params": false,
  "body_max_bytes": 65536,
  "async_context": true,
  "checks": {
    "sql": {"enabled": true, "action": "block"},
    "command": {"enabled": true, "action": "block"},
    "readFile": {"enabled": true, "action": "block"},
    "writeFile": {"enabled": true, "action": "block"},
    "ssrf": {"enabled": true, "action": "block"},
    "deserialization": {"enabled": true, "action": "block"},
    "jndi": {"enabled": true, "action": "block"}
  },
  "rules": [
    {"id": "command-in-request", "type": "command", "action": "log", "confidence": 50,
     "reason": "a process was started while handling an HTTP request",
     "conditions": [{"field": "$in_request", "op": "eq", "value": "true"}]},
    {"id": "command-user-input", "type": "command", "action": "log", "confidence": 70,
     "reason": "process arguments contain user input",
     "conditions": [{"field": "argv", "op": "contains_user_input", "min_len": 4}]},
    {"id": "read-user-input", "type": "readFile", "action": "log", "confidence": 60,
     "reason": "file path contains user input",
     "conditions": [{"field": "path", "op": "contains_user_input", "min_len": 4}]},
    {"id": "write-user-input", "type": "writeFile", "action": "log", "confidence": 60,
     "reason": "written file path contains user input",
     "conditions": [{"field": "path", "op": "contains_user_input", "min_len": 4}]},
    {"id": "ssrf-user-input", "type": "ssrf", "action": "log", "confidence": 60,
     "reason": "outbound URL contains user input",
     "conditions": [{"field": "url", "op": "contains_user_input", "min_len": 6}]},
    {"id": "sql-user-input", "type": "sql", "action": "log", "confidence": 40,
     "reason": "SQL text contains user input (string concatenation)",
     "conditions": [{"field": "query", "op": "contains_user_input", "min_len": 4}]},
    {"id": "jndi-user-input", "type": "jndi", "action": "log", "confidence": 70,
     "reason": "JNDI lookup name contains user input",
     "conditions": [{"field": "name", "op": "contains_user_input", "min_len": 4}]},
    {"id": "deserialization-denylist", "type": "deserialization", "action": "block", "confidence": 90,
     "reason": "class is on the deserialization deny list (maintained by the security team)",
     "conditions": [{"field": "clazz", "op": "in", "value": []}]}
  ],
  "whitelist": [],
  "block_response": {"status": 403},
  "breaker": {"avg_check_us": 2000, "errors_per_window": 200, "window_sec": 10, "recover_sec": 300},
  "report": {"stack_depth": 50},
  "privacy": {"mask_headers": ["cookie", "authorization"], "mask_params": ["password", "passwd", "pwd", "token", "secret"]}
}

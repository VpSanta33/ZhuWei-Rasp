# /etc/rasp/server.env — mode 0640, group rasp. See `rasp-server -h` for all options.
RASP_LISTEN=:8443
RASP_TLS_CERT=/etc/rasp/tls/server.crt
RASP_TLS_KEY=/etc/rasp/tls/server.key
RASP_AGENT_URL=https://rasp.example.com:8443
RASP_DB=/var/lib/rasp/rasp.db
# Prometheus scrape target; keep it on loopback or an internal interface
RASP_OPS_LISTEN=127.0.0.1:9480
# Alarm events per second accepted per application (burst 10x)
RASP_ALARM_RATE=100
# Only used on the very first start to create the admin account; remove it afterwards.
RASP_ADMIN_PASSWORD=change-me-at-least-12-chars

# Optional LDAP / Active Directory login (local accounts are always tried first)
#RASP_LDAP_URL=ldaps://ldap.example.com:636
#RASP_LDAP_BIND_DN=cn=rasp-svc,ou=service,dc=example,dc=com
#RASP_LDAP_BIND_PASSWORD=
#RASP_LDAP_BASE_DN=ou=people,dc=example,dc=com
#RASP_LDAP_USER_ATTR=uid
#RASP_LDAP_ADMIN_GROUP=cn=rasp-admins,ou=groups,dc=example,dc=com
#RASP_LDAP_OPERATOR_GROUP=cn=rasp-operators,ou=groups,dc=example,dc=com
#RASP_LDAP_VIEWER_GROUP=cn=rasp-viewers,ou=groups,dc=example,dc=com

# Optional automatic vulnerability data updates (needs outbound HTTPS or HTTPS_PROXY)
#RASP_OSV_URL=https://osv-vulnerabilities.storage.googleapis.com/Maven/all.zip

# Optional SIEM forwarding of alarms and audit records (syslog RFC 5424)
#RASP_SYSLOG_ADDR=siem.example.com:6514
#RASP_SYSLOG_PROTO=tls
#RASP_SYSLOG_FORMAT=cef
#RASP_SYSLOG_LEVEL=all
